{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "files": [
    "scripts/**/*.ps1",
    "scripts/**/*.md"
  ],
  "ignorePaths": [
    "node_modules",
    "**/bin/**",
    "**/obj/**",
    "**/*.dll",
    "**/*.pdb",
    "**/*.json",
    "**/*.yml",
    "**/*.yaml",
    "**/GeneratedMSBuildEditorConfig.editorconfig"
  ],
  "ignoreWords": [
    "Ackermann",
    "Ackermann's",
    "Ackermannian",
    "Addorderlyopentelemetry",
    "ApiGateway",
    "Appsettings",
    "Asciimath",
    "Asciimathml",
    "backoff",
    "Bcrypt",
    "Bson",
    "BsonId",
    "Buildtransitive",
    "Carter",
    "Carters",
    "Cfb",
    "Csproj",
    "Csprojs",
    "Dto",
    "DTOs",
    "Edb",
    "Errordetail",
    "Github",
    "GraphQL",
    "Grpc",
    "Hangfire",
    "Hangfire's",
    "Hostbuilder",
    "Idempotency",
    "Incl",
    "Init",
    "InternalServerError",
    "Jwt",
    "JWTs",
    "JWE",
    "JWS",
    "JWKS",
    "Kebab",
    "Kebabcase",
    "MassTransit",
    "Maxretrycount",
    "MediatR",
    "Metapackage",
    "Middleware",
    "Mongodb",
    "MultiTenant",
    "Multitenancy",
    "Multitenant",
    "Nanoseconds",
    "Npgsql",
    "Nsubstitute",
    "OpenApi",
    "OpenAPI",
    "OpenIddict",
    "Orderly",
    "Param",
    "paswd",
    "passw",
    "Perms",
    "Persistable",
    "pg",
    "Postgres",
    "Postgresql",
    "Powershell",
    "precommit",
    "prepush",
    "psql",
    "Quartz",
    "Rabbitmq",
    "RabbitMQ",
    "Realtime",
    "rebalancing",
    "Rebus",
    "Regex",
    "Repos",
    "resiliency",
    "Resiliency",
    "Rider",
    "sandbox",
    "Serializer",
    "Serializeroptions",
    "Setenv",
    "Sharding",
    "Skippable",
    "Snapshot",
    "sortable",
    "Spectre",
    "Src",
    "Sqlserver",
    "Startup",
    "Stdout",
    "Stub",
    "swagger",
    "Testcontainers",
    "Th",
    "Todo",
    "UPD",
    "Upsert",
    "Upserts",
    "usings",
    "Uuid",
    "Webapplicationfactory",
    "Xunit",
    "xUnit",
    "xunit",
    "Yarp",
    "Zzzzzz"
  ],
  "ignoreRegExpList": [
    "`\\w+`",
    "<see\\s+cref=\\s*\"[^\"]*\"\\s*/>",
    "<c>[^<]*</c>",
    "<param\\s+name=\\s*\"[^\"]*\"\\s*/>",
    "<typeparam\\s+name=\\s*\"[^\"]*\"\\s*/>",
    "[A-Z][A-Za-z0-9]+(?=\\s*[(<])"
  ]
}
