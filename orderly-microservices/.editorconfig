# ============================================================
# TEMPORARY: suppress style warnings in canary projects until Phase 3 PR #3.1
# BuildingBlocks.Dev and BuildingBlocks.Dev.Tests both set
# <TreatWarningsAsErrors>true</TreatWarningsAsErrors>, so the promotion above
# would turn their existing var/brace/style violations into build errors.
# Phase 3 PR #3.1 fixes BuildingBlocks.Dev + Dev.Tests var sites and removes
# these overrides. See .agents/plan/platform/CODE_STYLE_ITERATION_PLAN.md §
# "Canary override" for context.
# ============================================================
[BuildingBlocks.Dev/**/*.cs]
csharp_style_var_for_built_in_types    = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere            = false:suggestion
csharp_prefer_braces                  = true:suggestion

[BuildingBlocks.Dev.Tests/**/*.cs]
csharp_style_var_for_built_in_types    = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere            = false:suggestion
csharp_prefer_braces                  = true:suggestion
