# Orderly local-development environment.
# Copy this file to `.env` (same directory) to override any of these values.
# Anything left blank or unset falls back to the dev defaults baked into
# docker-compose.override.yml, so a fresh checkout still works with no .env.
#
# The `.env` file is git-ignored. Do not commit real secrets here.

# --- PostgreSQL (catalogdb, basketdb, identitydb, discountdb) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- MSSQL (orderdb) ---
ACCEPT_EULA=Y
SA_PASSWORD=YrPsswrd123456789

# --- RabbitMQ (messagebroker) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- Redis (distributedcache) ---
REDIS_PASSWORD=redisdev

# --- ASP.NET dev cert (shared across all API services) ---
# Dev certs are generated by `dotnet dev-certs` and shared per team.
ASPNETCORE_Kestrel__Certificates__Default__Password=password123
