{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Audience": "OrderlyMicroservices"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "ForwardedHeaders": {
    "KnownNetworks": [
      "172.16.0.0/12"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "Default",
        "CorsPolicy": "Default",
        "Match": {
          "Path": "/catalog-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/catalog-api"
          }
        ]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "Default",
        "CorsPolicy": "Default",
        "Match": {
          "Path": "/basket-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/basket-api"
          }
        ]
      },
      "discount-route": {
        "ClusterId": "discount-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "Default",
        "CorsPolicy": "Default",
        "Match": {
          "Path": "/discount-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/discount-api"
          }
        ]
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "Default",
        "CorsPolicy": "Default",
        "Match": {
          "Path": "/ordering-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/ordering-api"
          }
        ]
      },
      "identity-public-auth-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "fixed",
        "CorsPolicy": "Default",
        "Match": {
          "Path": "/identity-api/v1/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity-api"
          }
        ]
      },
      "identity-public-api-auth-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "fixed",
        "CorsPolicy": "Default",
        "Match": {
          "Path": "/identity-api/api/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity-api"
          }
        ]
      },
      "identity-public-connect-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "fixed",
        "CorsPolicy": "Default",
        "Match": {
          "Path": "/identity-api/connect/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity-api"
          }
        ]
      },
      "identity-public-wellknown-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "fixed",
        "CorsPolicy": "Default",
        "Match": {
          "Path": "/identity-api/.well-known/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity-api"
          }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "Default",
        "CorsPolicy": "Default",
        "Order": 100,
        "Match": {
          "Path": "/identity-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity-api"
          }
        ]
      },
      "kitchen-route": {
        "ClusterId": "kitchen-cluster",
        "RateLimiterPolicy": "fixed",
        "AuthorizationPolicy": "Default",
        "CorsPolicy": "Default",
        "Match": {
          "Path": "/kitchen-api/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/kitchen-api"
          }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://catalog.api:8080"
          }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://basket.api:8080"
          }
        }
      },
      "discount-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://discount.grpc:8080"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://ordering.api:8080"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://identity.api:8080"
          }
        }
      },
      "kitchen-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://kitchen.api:8080"
          }
        }
      }
    }
  }
}
