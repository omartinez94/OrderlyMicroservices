<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ASP.NET Core reference assemblies bring IConfiguration, IHostBuilder,
      IWebHostBuilder, and IApplicationBuilder into scope without forcing the
      whole Microsoft.AspNetCore.App framework reference on consumers that
      happen to be class libraries. The OpenTelemetry instrumentation packages
      require these types.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      OpenTelemetry 1.17.0 is the version Basket already references; pinning
      here keeps the trace correlation consistent across services. Npgsql's
      OpenTelemetry plugin is the only DB-side instrumentation we wire today
      (Catalog / Basket / Discount / Kitchen / Ordering all use Npgsql except
      Ordering, which uses SQL Server; SQL Server instrumentation is deferred
      — see PERSISTENCE_AND_RELIABILITY_PLAN.md §A7).
    -->
    <PackageReference Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BuildingBlocks.Observability.Tests" />
  </ItemGroup>

</Project>
