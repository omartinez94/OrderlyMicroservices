      Phase 3 (DOCKER_BUILD_PERFORMANCE_PLAN): Directory.Packages.props
      ships as a future-state document but CPM is NOT activated (see
      Directory.Build.props for the rationale). All Version="..." stay
      explicit so this csproj is self-contained.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks\BuildingBlocks.csproj" />
  </ItemGroup>

</Project>