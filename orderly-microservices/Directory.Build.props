<Project>
  <!--
    Central MSBuild configuration for every .csproj under orderly-microservices/.
    Loaded automatically by MSBuild for any project beneath this directory.

    Phase 1 of .agents/plan/platform/QUALITY_GATE_ENHANCEMENT_PLAN.md —
    Formatting, Style & Secret Scanning. The accompanying .editorconfig at
    this same level tunes StyleCop severity; this file just wires the analyzer.

    TreatWarningsAsErrors is intentionally false in Phase 1: the plan §10
    requires StyleCop rules to be tuned via .editorconfig before promoting
    warnings to errors. See the plan for the promotion path.

    Phase 0 of CODE_STYLE_ITERATION_PLAN.md adds EnforceCodeStyleInBuild=true
    so the IDE0xxx style rules (var → explicit type, IDE0008; braces,
    IDE0011; pattern matching, IDE0020/0019/0078/0083/0170) actually surface
    as compile warnings. Without this flag, .editorconfig severity settings
    are advisory-only and only the IDE surfaces them; the build stays silent
    on style drift. The accompanying .editorconfig promotes these rules to
    :warning and exempts test projects ([*Tests/**/*.cs] override) so this
    doesn't break the test suite. BuildingBlocks.Dev + .Tests suppress via
    their own .csproj NoWarn since TWAE=true ignores .editorconfig severity
    overrides (verified 2026-08-27).
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' != '.dcproj'">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' != '.dcproj'">
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
