<Project>
  <!--
    Central MSBuild configuration for every .csproj under orderly-microservices/.
    Loaded automatically by MSBuild for any project beneath this directory.

    Phase 1 of .agents/plan/platform/QUALITY_GATE_ENHANCEMENT_PLAN.md —
    Formatting, Style & Secret Scanning. The accompanying .editorconfig at
    this same level tunes StyleCop severity; this file just wires the analyzer.

    TreatWarningsAsErrors is intentionally false in Phase 1: the plan §10
    requires StyleCop rules to be tuned via .editorconfig before promoting
    warnings to errors. See the plan for the promotion path.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
