# Mirror of orderly-microservices/.env.example
# Copy this file to `.env` and adjust as needed. The `.env` file is git-ignored.

# --- PostgreSQL (catalogdb, basketdb, identitydb, kitchendb) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- MSSQL (orderdb) ---
SA_PASSWORD=YrPsswrd123456789

# --- RabbitMQ (messagebroker) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# --- Redis (distributedcache) ---
REDIS_PASSWORD=redisdev

# --- ASP.NET dev cert (matches docker-compose.override.yml) ---
ASPNETCORE_Kestrel__Certificates__Default__Password=password123

# --- MCP server ---
# NODE_ENV is locked to "development" — the server refuses to start otherwise.
NODE_ENV=development

# Bind address. Defaults to 0.0.0.0 so LAN clients (e.g. 192.168.1.65) can connect.
HOST=0.0.0.0

# MCP port (matches plan §4 — Transport row).
PORT=8080

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Comma-separated whitelist of allowed DB / Redis / RabbitMQ hostnames.
# Anything else is rejected by assertDevHost() before any connection attempt.
DEV_HOST=localhost,127.0.0.1

# REQUIRED. Min 16 chars. Used by `generate_dev_token` in Phase 2.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me-with-a-dev-only-secret-at-least-16-chars

# REQUIRED by `trigger_scheduled_jobs` (§6.7). Shared with the .NET
# services' `BuildingBlocks.Dev.DevTriggerEndpointExtensions.ValidateSecretAsync`
# gate (must match the `DEV_TRIGGER_SECRET` env var on basket.api /
# ordering.api). Used for the dev-only POST /_dev/trigger/{name} endpoints.
DEV_TRIGGER_SECRET=replace-me-with-a-dev-only-trigger-secret

# Set to "1" to enable the live-backend integration tests in
# test/flows/checkout.live.test.ts. Default off so CI stays hermetic.
# Enable locally: `export MCP_LIVE_TEST=1`
# MCP_LIVE_TEST=0

# Discount gRPC endpoint used by the `discount-application` flow
# (§6.8). Defaults to the docker-compose service name; override for
# local debugging.
# DEV_GRPC_DISCOUNT_URL=discount.grpc:6002

# Coupon code to look up in the `discount-application` flow's
# `get-discount-by-code` + `redeem-discount` steps. The dev seed
# (`WELCOME10`) is the project's standard fixture.
# DEV_FIXTURE_COUPON_CODE=WELCOME10
