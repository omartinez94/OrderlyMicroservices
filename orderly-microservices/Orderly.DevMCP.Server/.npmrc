# Mimic npm's flat node_modules layout. The gRPC / mssql / @azure-msal / amqplib
# transitive trees assume flat hoisting; without this pnpm will surface phantom
# peer-dep warnings and some lookups will fail at runtime.
shamefully-hoist=true

# Pin the store to a stable per-user location so dev + CI can share a cache
# (saves ~250 MB per service in the multi-replica docker-compose case).
store-dir=~/.local/share/pnpm/store

# Less noisy CI output; flip to "info" locally when debugging.
loglevel=warn
