{
  "ConnectionStrings": {
    "CatalogDB": "Server=localhost;Port=5433;Database=Catalogdb;User Id=postgres;Password=postgres;IncludeErrorDetail=true;",
    "Redis": "localhost:6379"
  },
  "MessageBroker": {
    "Host": "amqp://localhost:5672",
    "UserName": "guest",
    "Password": "guest"
  },
  "Catalog": {
    "CacheRepairIntervalMinutes": 5,
    "MenuCacheTtlMinutes": 60,
    "IngredientCacheTtlMinutes": 5,
    "OutboxDeadLetterThreshold": 0
  },
  "BlobStorage": {
    "Provider": "AzureBlob",
    "ConnectionString": "UseDevelopmentStorage=true",
    "PublicBaseUrl": "http://localhost:10000/devstoreaccount1",
    "ContainerName": "menu-assets"
  },
  "FeatureManagement": {
    "CatalogMenuEvents": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}