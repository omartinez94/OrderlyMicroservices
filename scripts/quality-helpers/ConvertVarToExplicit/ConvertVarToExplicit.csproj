<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Orderly.QualityHelpers.ConvertVarToExplicit</RootNamespace>
    <AssemblyName>convert-var-to-explicit</AssemblyName>
    <!-- Phase 0 / Step 0.5 mirror: this tool builds with -warnaserror-equivalent
         strictness, so any analyzer noise becomes a build error. We suppress the
         same set as BuildingBlocks.Dev since this is also canary-class code. -->
    <NoWarn>$(NoWarn);SA1200;SA1633;SA1634;SA1635;SA1636;SA1637;SA1638;SA1640;SA1641;SA1402;SA1513;SA1518;SA0001;CA1032;CA1031;CA1062;CA1307;CA1848;CA1873;CA2007;IDE0008;IDE0011;IDE0078</NoWarn>
    <!-- The tool itself IS a one-shot converter; running it through the var
         rule would mean re-converting its own output every run. IDE0008
         suppression above already covers it, but be explicit. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.9.1" />
  </ItemGroup>

</Project>
